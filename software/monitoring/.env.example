# Local: copy to .env.local. On Vercel: add the same names under Project -> Settings -> Environment Variables.
# Never commit real values.

# Supabase (Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ESP32 sends this in the x-api-key header
DEVICE_API_KEY=change-me-to-a-long-random-string
# Password to open the dashboard (leave empty only for local testing)
DASHBOARD_PASSWORD=choose-a-password

# Telegram bot (@BotFather)
TELEGRAM_BOT_TOKEN=your-bot-token   # same bot as the controller is fine (the server only sends)
TELEGRAM_CHAT_ID=

# OpenWeather (openweathermap.org -> API keys). Lat/lon of your nursery (right-click in Google Maps to copy).
OPENWEATHER_API_KEY=your-openweather-key
WEATHER_LAT=14.7011
WEATHER_LON=121.0366

TRAY_ROWS=6
TRAY_COLS=12
# Tray stage from the green (ExG) share of the photo: below NO_GREEN_PCT = no green yet,
# at/above FULL_GREEN_PCT = tray full of green -> the dashboard alerts you to check for transplanting.
NO_GREEN_PCT=5
FULL_GREEN_PCT=85

# Water flow (mL per minute) of the mist maker and pump, to estimate water use on the Mist Reservoir page.
# Measure: run it for 60 s into a measuring cup.
MIST_ML_PER_MIN=0
PUMP_ML_PER_MIN=0

