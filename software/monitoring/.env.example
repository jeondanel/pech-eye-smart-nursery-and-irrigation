# Local: copy to .env.local. On Vercel: add the same names under Project -> Settings -> Environment Variables.
# Never commit real values.

# Supabase (Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ESP32 sends this in the x-api-key header
DEVICE_API_KEY=change-me-to-a-long-random-string
# Password to open the dashboard (leave empty only for local testing)
DASHBOARD_PASSWORD=choose-a-password

# Telegram bot (@BotFather)
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=

# OpenWeather (openweathermap.org -> API keys). Lat/lon of your nursery (right-click in Google Maps to copy).
OPENWEATHER_API_KEY=your-openweather-key
WEATHER_LAT=14.7011
WEATHER_LON=121.0366

TRAY_ROWS=6
TRAY_COLS=12
MOUNT_HEIGHT_CM=30
READY_THRESHOLD=0.8
